{
  "name": "@datspike/pi-inline-slash-extension",
  "version": "0.1.0",
  "description": "Pi extension that adds inline slash autocomplete and absolute-path submit bypass without forking core.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datspike/pi-inline-slash-extension.git"
  },
  "homepage": "https://github.com/datspike/pi-inline-slash-extension#readme",
  "bugs": {
    "url": "https://github.com/datspike/pi-inline-slash-extension/issues"
  },
  "keywords": ["pi-package", "pi", "extension", "autocomplete", "slash-commands"],
  "files": [
    "extensions",
    "src",
    "docs/UPSTREAM-SEAMS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": ["./extensions/inline-slash.ts"]
  },
  "scripts": {
    "test": "vitest",
    "verify:s01": "vitest --run tests/inline-slash/classifier.test.ts tests/inline-slash/command-catalog.test.ts tests/inline-slash/provider.test.ts tests/inline-slash/editor-smoke.test.ts",
    "verify:s02": "vitest --run tests/inline-slash/classifier.test.ts tests/inline-slash/submit-routing.test.ts tests/inline-slash/editor-smoke.test.ts && tsc --noEmit",
    "verify:s03": "bash scripts/verify-s03.sh"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.65.0",
    "@types/node": "^24.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
